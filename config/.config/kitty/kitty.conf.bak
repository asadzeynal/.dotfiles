# background #242933
# foreground #bbc3d4
# selection_background #1b1f26
# selection_foreground #bbc3d4
# cursor #bbc3d4
# cursor_text_color #191d24
# color0 #191d24
# color1 #bf616a
# color2 #a3be8c
# color3 #ebcb8b
# color4 #5e81ac
# color5 #b48ead
# color6 #8fbcbb
# color7 #bbc3d4
# color8 #3b4252
# color9 #c5727a
# color10 #b1c89d
# color11 #efd49f
